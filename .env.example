# Bu dosyayi .env olarak kopyalayip gercek degerleri girin. .env asla git'e girmez.

# --- LLM + Embedding (Faz 4 - RAG) ---
# Saglayici secimi config/config.yaml'dadir (llm.provider, rag.embedding_provider), burada degil.
# Varsayilan: LLM = openai (gpt-4.1-mini, odemeli - https://platform.openai.com/api-keys),
# embedding = huggingface (ucretsiz - https://huggingface.co/settings/tokens, kart gerektirmez).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# --- OCR (Faz 3) - opsiyonel ucuncu motor, karsilastirma amacli ---
# Ucretsiz katman icin kayit: https://ocr.space/ocrapi (kart gerektirmez)
OCR_SPACE_API_KEY=

# --- API (Faz 6) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Kimlik Dogrulama (JWT - kullanici girisi/kaydi) ---
# ONEMLI: Bos birakilirsa kod icinde sabit bir varsayilan anahtara duser - bu varsayilan
# public repoda gorunur oldugundan GUVENLI DEGILDIR. Gercek/deploy ortaminda MUTLAKA
# kendi rastgele degerinizi girin, ornegin: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
